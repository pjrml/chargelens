# SECURITY: secrets never live in the working tree (see README.private.md, local only).
# These patterns are only a safety net.
*.env
*.env.*
.env
*.pem
*.key
*.pfx
*.p12
*.ppk
id_*
!id_*.pub
**/backups/

# Device dumps and exports may hold personal data (mail recipient, names, location): never commit them
chargelens-config-*.json
*.backup.json

# Claude Code per-user local settings and local tool state
.claude/settings.local.json
CLAUDE.local.md
.superpowers/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node (only for local test runners)
node_modules/
npm-debug.log*

# Editors / OS
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/

# Note: dist/ is committed on purpose (served to devices through raw.githubusercontent.com).

